# ==============================================================================
# NIU — Network for Intelligent Urban Mobility
# Environment Configuration Template
# ==============================================================================
# NOTE: The current phase operates in local simulation mode.
# No active keys are required to run the local prototype.
# Do not add secrets to this file or commit .env.local with credentials.

# Future Mapbox Vector Tile & Directions Provider
NEXT_PUBLIC_MAPBOX_TOKEN=

# Future Supabase Backend & Database Service
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future External Traffic API Integration (e.g. TomTom / HERE / Municipal ITMS)
NEXT_PUBLIC_TRAFFIC_API_KEY=

# Future ML Inference Microservice (FastAPI Traffic Model)
NEXT_PUBLIC_ML_SERVICE_URL=
