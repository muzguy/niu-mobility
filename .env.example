# ==============================================================================
# NIU — Network for Intelligent Urban Mobility
# Environment Configuration Template
# ==============================================================================
# NOTE: The current phase operates in local simulation mode.
# No active keys are required to run the local prototype.
# Do not add secrets to this file or commit .env.local with credentials.

# CARTO Basemap API Key
# Required for the CARTO basemap used by the MapLibre map.
# Do not commit the real key. Put it in .env.local locally and in
# Vercel Environment Variables for deployment.
NEXT_PUBLIC_CARTO_API_KEY=

# Optional Custom MapLibre Map Style URL (e.g. Vector Tileset / Custom Style JSON)
NEXT_PUBLIC_MAP_STYLE_URL=

# Future Mapbox Vector Tile & Directions Provider (Optional / Future Provider)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Future Supabase Backend & Database Service
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future External Traffic API Integration (e.g. TomTom / HERE / Municipal ITMS)
NEXT_PUBLIC_TRAFFIC_API_KEY=

# Future ML Inference Microservice (FastAPI Traffic Model)
NEXT_PUBLIC_ML_SERVICE_URL=
